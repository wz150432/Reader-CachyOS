option(READER_BUILD_ONLINE_ENGINE "Build optional online reading component" OFF)
set(READER_ONLINE_VERSION "0.1.0" CACHE STRING "Optional component protocol build version")
if(NOT READER_ONLINE_VERSION MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.-]+)?$")
 message(FATAL_ERROR "READER_ONLINE_VERSION must be a semantic version triplet")
endif()
if(READER_BUILD_ONLINE_ENGINE)
 find_package(LibXml2 REQUIRED)
 find_package(Qt6 REQUIRED COMPONENTS Concurrent)
 add_library(reader_online_engine STATIC src/online/engine/HtmlRuleParser.cpp src/online/engine/NovelSourceClient.cpp)
 target_compile_definitions(reader_online_engine PRIVATE READER_ONLINE_VERSION="${READER_ONLINE_VERSION}")
 target_include_directories(reader_online_engine PUBLIC src/online/engine)
 target_link_libraries(reader_online_engine PUBLIC Qt6::Core Qt6::Network Qt6::Concurrent LibXml2::LibXml2)
 add_executable(reader-online src/online/engine/main.cpp)
 target_link_libraries(reader-online PRIVATE reader_online_engine)
 set_target_properties(reader-online PROPERTIES BUILD_WITH_INSTALL_RPATH TRUE INSTALL_RPATH "$ORIGIN/lib")
 add_executable(tst_onlineengine tests/tst_onlineengine.cpp)
 target_link_libraries(tst_onlineengine PRIVATE Qt6::Test Qt6::Network)
 target_compile_definitions(tst_onlineengine PRIVATE READER_ONLINE_VERSION="${READER_ONLINE_VERSION}" ENGINE_PATH="$<TARGET_FILE:reader-online>" ONLINE_FIXTURES="${CMAKE_CURRENT_SOURCE_DIR}/tests/online")
 add_dependencies(tst_onlineengine reader-online)
 add_test(NAME onlineengine COMMAND tst_onlineengine)
endif()
