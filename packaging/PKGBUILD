# Maintainer: YOUR NAME <your@email.example>
# Contributor: YOUR NAME <your@email.example>
# Replace YOUR_USERNAME with the account that hosts Reader-CachyOS on Git.

pkgname=reader-cachyos-git
_version=0.1.0
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc="Offline TXT/EPUB/MOBI reader for CachyOS/Arch"
arch=('x86_64')
url='https://github.com/YOUR_USERNAME/Reader-CachyOS'
license=('custom')
depends=('qt6-base')
makedepends=('cmake' 'git')
conflicts=('reader')
provides=('reader')
install=reader.install
source=("${pkgname}::git+${url}.git#branch=main")
md5sums=('SKIP')

pkgver() {
    cd "${srcdir}/${pkgname}"
    git describe --long --tags --always | sed 's/^v//; s/\([^-]*-g\)/r\1/; s/-/./g'
}

build() {
    cmake -B build -S "${srcdir}/${pkgname}" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build -j"$(nproc)"
}

package() {
    cd "${srcdir}/${pkgname}"
    install -Dm755 build/reader "${pkgdir}/usr/bin/reader"
    install -Dm644 packaging/reader.desktop \
        "${pkgdir}/usr/share/applications/reader.desktop"
    install -Dm644 packaging/reader.svg \
        "${pkgdir}/usr/share/icons/hicolor/scalable/apps/reader.svg"
    install -Dm644 packaging/reader-mime.xml \
        "${pkgdir}/usr/share/mime/packages/reader.xml"
}
