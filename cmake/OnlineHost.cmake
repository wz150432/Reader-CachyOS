set(READER_ONLINE_METADATA "" CACHE FILEPATH "Official online component metadata JSON")
set(_online_bytes "0")
if(READER_ONLINE_METADATA)
 if(NOT IS_ABSOLUTE "${READER_ONLINE_METADATA}")
  message(FATAL_ERROR "READER_ONLINE_METADATA must be absolute")
 endif()
 file(READ "${READER_ONLINE_METADATA}" _online_json HEX)
 string(REGEX REPLACE "(..)" "0x\\1," _online_bytes "${_online_json}")
 string(APPEND _online_bytes "0")
endif()
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/OnlineMetadata.h" CONTENT "#pragma once\nstatic constexpr unsigned char onlineMetadata[] = {${_online_bytes}};\n")
